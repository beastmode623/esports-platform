generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Tournament {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  game        String
  prizePool   String
  status      String
  startDate   String
  description String
  format      String
  region      String
  entryFee    String

  @@map("tournaments")
}